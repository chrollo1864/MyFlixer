NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/myflixer
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Generate a unique random value of at least 32 characters.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# First administrator created at startup. Use 8 to 128 characters.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_PASSWORD_OF_AT_LEAST_8_CHARACTERS

# SMTP settings used to send registration verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional TMDB API key. Keep it server-side; do not commit it.
TMDB_API_KEY=
